{
  "compilerOptions": {
    // Type checking
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "types": ["node"],

    // Module resolution
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "paths": {
      "@pages/*":      ["./src/ui/pages/*"],
      "@components/*": ["./src/ui/components/*"],
      "@fixtures":     ["./src/fixtures/index"],
      "@fixtures/*":   ["./src/fixtures/*"],
      "@data/*":       ["./src/data/*"],
      "@config/*":     ["./src/config/*"],
      "@helpers/*":    ["./src/helpers/*"],
      "@api/*":        ["./src/api/*"]
    },

    // Output (type-check only, no emit)
    "noEmit": true,

    // Interop
    "esModuleInterop": true,
    "resolveJsonModule": true,

    // Target
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "ESNext.AsyncIterable"]
  },
  "include": [
    "playwright.config.ts",
    "tests/**/*.ts",
    "src/**/*.ts"
  ]
}
