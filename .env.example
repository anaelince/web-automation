# ─────────────────────────────────────────────────────────────────────────────
# Environment selection
#   TEST_ENV=<name> npx playwright test   →  loads .env.<name>
#   TEST_ENV unset                         →  loads .env.local, or .env if it does not exist
# Copy this file to .env (local) or .env.<name> (e.g. .env.qa, .env.staging).
# All .env.* files except this one are git-ignored.
# ─────────────────────────────────────────────────────────────────────────────

# REQUIRED — base URL of the primary application under test, demoqa (http/https)
BASE_URL=http://localhost:3000

# OPTIONAL — base URLs of the other sites (defaults shown). Each site's fixture file
# (src/fixtures/sites/{site}/{site}.fixtures.ts) sets Playwright's baseURL to its own URL.
SAUCEDEMO_BASE_URL=https://www.saucedemo.com
AUTOMATIONEXERCISE_BASE_URL=https://automationexercise.com

# OPTIONAL — SauceDemo login user (default: SauceDemo's public demo account).
# TEST_USER_NAME / TEST_USER_PASSWORD below are the demoqa user only.
SAUCEDEMO_USER_NAME=standard_user
SAUCEDEMO_USER_PASSWORD=secret_sauce

# OPTIONAL — static test user, only for flows that log in with a seeded user.
# Self-provisioned identities (workerUser fixture) do not need these.
TEST_USER_NAME=
TEST_USER_PASSWORD=

# OPTIONAL — prefix of generated test records (default: qa_)
TEST_DATA_PREFIX=qa_

# OPTIONAL — allow bulk cleanup of data not owned by the test (default: false).
# Keep false in shared environments (staging, production-like).
ALLOW_DESTRUCTIVE_CLEANUP=false
